//REVISADO
model EmailLogs {
  id             Int          @id @default(autoincrement())
  fechaHoraEnvio DateTime?
  emailConfigId  Int?
  emailConfig    EmailConfig? @relation(fields: [emailConfigId], references: [id])
  contacto       Contacto?    @relation(fields: [contactoId], references: [id])
  contactoId     Int?
  estadoEmailId  Int?
  estadoEmail    EstadoEmail? @relation(fields: [estadoEmailId], references: [id])

  @@map("EmailLogs")
}
