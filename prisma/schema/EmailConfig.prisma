//REVISADO
model EmailConfig {
  id                   Int                  @id @default(autoincrement())
  nombre               String
  descripcion          String
  asunto               String
  plantilla            String
  fechaGeneracionEnvio DateTime?
  encuestaId           Int?
  listaEmpresasEmail   ListaEmpresasEmail[]
  emailLogs            EmailLogs[]
  estadoEmailId        Int
  estadoEmail          EstadoEmail          @relation(fields: [estadoEmailId], references: [id])

  @@map("EmailConfig")
}
